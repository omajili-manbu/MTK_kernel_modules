config MTK_CFI_N_INI
    bool "Enable feature MTK_CFI_N_INI"
    depends on CFI_CLANG && CFI_ICALL_NORMALIZE_INTEGERS
    default y if CFI_CLANG && CFI_ICALL_NORMALIZE_INTEGERS
    help
        it is only work when CONFIG_CFI_CLANG set && CONFIG_CFI_ICALL_NORMALIZE_INTEGERS set

config MTK_CFI_ONLY
    bool "Enable feature MTK_CFI_ONLY"
    depends on CFI_CLANG && !CFI_ICALL_NORMALIZE_INTEGERS
    default y if CFI_CLANG && !CFI_ICALL_NORMALIZE_INTEGERS
    help
        it is only work when CONFIG_CFI_CLANG set && CONFIG_CFI_ICALL_NORMALIZE_INTEGERS unset

config MTK_POWER_RL_V2_CFI_N_INI
    bool "Enable feature MTK_POWER_RL_V2_CFI_N_INI"
    depends on CFI_CLANG && CFI_ICALL_NORMALIZE_INTEGERS && MTK_POWER_RL_V2
    default y if CFI_CLANG && CFI_ICALL_NORMALIZE_INTEGERS && MTK_POWER_RL_V2
    help
        it is only work when CONFIG_CFI_CLANG set && CONFIG_CFI_ICALL_NORMALIZE_INTEGERS && CONFIG_MTK_POWER_RL_V2 set

config MTK_POWER_RL_V2_CFI_ONLY
    bool "Enable feature MTK_POWER_RL_V2_CFI_ONLY"
    depends on CFI_CLANG && !CFI_ICALL_NORMALIZE_INTEGERS && MTK_POWER_RL_V2
    default y if CFI_CLANG && !CFI_ICALL_NORMALIZE_INTEGERS && MTK_POWER_RL_V2
    help
        it is only work when CONFIG_CFI_CLANG set && CONFIG_CFI_ICALL_NORMALIZE_INTEGERS unset && CONFIG_MTK_POWER_RL_V2 set

config MTK_POWER_RL_V2_NO_CFI
    bool "Enable feature MTK_POWER_RL_V2_NO_CFI"
    depends on !CFI_CLANG && MTK_POWER_RL_V2
    default y if !CFI_CLANG && MTK_POWER_RL_V2
    help
        it is only work when CONFIG_CFI_CLANG unset && CONFIG_MTK_POWER_RL_V2 set